generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─────────────────────────────────────────────
// HALITE PLATFORM ADMIN
// ─────────────────────────────────────────────

model HaliteAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("halite_admins")
}

// ─────────────────────────────────────────────
// BRANDS
// ─────────────────────────────────────────────

model Brand {
  id         String       @id @default(cuid())
  name       String
  slug       String       @unique
  apiKey     String       @unique @default(cuid())
  plan       BrandPlan    @default(STARTER)
  active     Boolean      @default(true)
  focusAreas BeautyArea[]

  // Shopify integration
  shopifyShop           String? @unique
  // Deprecated: legacy plaintext token, kept only as a read fallback for
  // brands that connected before shopifyTokenEncrypted existed. New writes
  // always go to the encrypted field — see apps/api/src/lib/secret-box.ts.
  shopifyToken          String?
  shopifyTokenEncrypted String?
  shopifyWebhookSecret  String?

  // Branding
  logoUrl      String?
  primaryColor String? @default("#000000")

  // Brand type
  type   BrandType @default(ONBOARDED)
  isDemo Boolean   @default(false)

  // Demo environment
  demoProspectName      String?
  demoCreatedBy         String?
  demoLinkExpiresAt     DateTime?
  demoConvertedAt       DateTime?
  demoProvisioningError Json?
  // Encrypted so the admin dashboard can still display the demo login to
  // share with a prospect without a second plaintext-password column.
  demoPasswordEncrypted String?

  // White-label
  whiteLabelEnabled Boolean @default(false)
  brandWebsiteUrl   String?
  brandThemeConfig  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins               BrandAdmin[]
  products             Product[]
  endUsers             EndUser[]
  quizSessions         QuizSession[]
  catalogUploads       CatalogUpload[]
  quizConfig           QuizConfig?
  invoices             Invoice[]
  crystalConversations CrystalConversation[]
  agentWorkflows       AgentWorkflow[]
  loginEvents          LoginEvent[]
  consumerEvents       ConsumerEvent[]
  consentGrants        ConsentGrant[]
  recommendations      Recommendation[]
  connectEvents        ConnectEvent[]

  @@map("brands")
}

enum BrandType {
  DEMO
  ONBOARDED
}

enum BrandPlan {
  STARTER
  GROWTH
  ENTERPRISE
}

enum BeautyArea {
  SKINCARE
  BODY
  HAIR
  MAKEUP
  FRAGRANCE
  NAILS
  WELLNESS
  SUN_CARE
  LIP_CARE
  EYE_CARE
}

model BrandAdmin {
  id        String    @id @default(cuid())
  brandId   String
  email     String    @unique
  password  String
  name      String
  phone     String?
  role      AdminRole @default(MEMBER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  loginEvents LoginEvent[]

  @@map("brand_admins")
}

enum AdminRole {
  OWNER
  MEMBER
}

// ─────────────────────────────────────────────
// LOGIN EVENTS (audit log)
// ─────────────────────────────────────────────

enum LoginMethod {
  LOGIN
  REGISTER
  IMPERSONATE
}

model LoginEvent {
  id         String      @id @default(cuid())
  brandId    String
  adminId    String
  adminEmail String
  adminName  String
  ip         String?
  method     LoginMethod @default(LOGIN)
  createdAt  DateTime    @default(now())

  brand Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  admin BrandAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt(sort: Desc)])
  @@map("login_events")
}

// ─────────────────────────────────────────────
// QUIZ CONFIG (per brand)
// ─────────────────────────────────────────────

model QuizConfig {
  id                String       @id @default(cuid())
  brandId           String       @unique
  enabledAreas      BeautyArea[]
  // JSON: hide/reorder/relabel default questions per area
  questionOverrides Json         @default("{}")
  // JSON: brand-specific add-on questions
  customQuestions   Json         @default("[]")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("quiz_configs")
}

// ─────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────

model CatalogUpload {
  id          String        @id @default(cuid())
  brandId     String
  fileName    String
  fileUrl     String
  format      CatalogFormat
  source      UploadSource  @default(USER_UPLOADED)
  status      UploadStatus  @default(PENDING)
  rowCount    Int?
  errorLog    Json?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("catalog_uploads")
}

enum CatalogFormat {
  CSV
  JSON
  SHOPIFY_SYNC
  XLSX
}

enum UploadSource {
  USER_UPLOADED
  AI_GENERATED
}

enum UploadStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model Product {
  id               String                       @id @default(cuid())
  brandId          String
  externalId       String?
  name             String
  description      String?
  category         ProductCategory
  subcategory      String?
  beautyArea       BeautyArea                   @default(SKINCARE)
  concerns         SkinConcern[]
  monkSkinTones    Int[]
  skinTypes        SkinType[]
  ingredients      String[]
  keyIngredients   String[]
  price            Float
  currency         String                       @default("USD")
  imageUrl         String?
  productUrl       String?
  shopifyVariantId String?
  inStock          Boolean                      @default(true)
  metadata         Json?
  /// @db.VectorType(1536) — populated async after ingestion
  embedding        Unsupported("vector(1536)")?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  brand           Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  routineSteps    RoutineStep[]
  checkInProducts CheckInProduct[]
  hallieShelf     HallieShelfProduct[]

  @@unique([brandId, externalId])
  @@map("products")
}

enum ProductCategory {
  // Skincare — face
  CLEANSER
  TONER
  SERUM
  MOISTURIZER
  EYE_CREAM
  SPF
  MASK
  EXFOLIANT
  FACIAL_OIL
  MIST
  SPOT_TREATMENT
  // Body
  BODY_WASH
  BODY_MOISTURIZER
  BODY_OIL
  BODY_SCRUB
  BODY_TREATMENT
  BODY_SPF
  // Hair
  SHAMPOO
  CONDITIONER
  HAIR_MASK
  SCALP_TREATMENT
  LEAVE_IN
  HAIR_OIL
  STYLING
  // Makeup
  PRIMER
  FOUNDATION
  CONCEALER
  BLUSH_BRONZER
  EYE_MAKEUP
  LIP_COLOR
  SETTING_SPRAY
  SETTING_POWDER
  COLOR_CORRECTOR
  // Fragrance
  EAU_DE_PARFUM
  EAU_DE_TOILETTE
  BODY_MIST_SCENTED
  HAIR_MIST
  // Nails
  NAIL_TREATMENT
  NAIL_COLOR
  CUTICLE_OIL
  BASE_COAT
  TOP_COAT
  // Wellness
  SUPPLEMENT
  COLLAGEN
  // Lip
  LIP_BALM
  LIP_TREATMENT
  LIP_PLUMPER
  // Eye & Brow
  LASH_SERUM
  BROW_SERUM
  EYE_PATCHES
  // Generic
  BALM
  OTHER
}

enum SkinConcern {
  ACNE
  HYPERPIGMENTATION
  AGING
  SENSITIVITY
  DRYNESS
  OILINESS
  REDNESS
  DULLNESS
  UNEVEN_TEXTURE
  DARK_CIRCLES
  PORES
  DEHYDRATION
}

enum SkinType {
  DRY
  OILY
  COMBINATION
  NORMAL
  SENSITIVE
}

// ─────────────────────────────────────────────
// PLATFORM CONSUMER IDENTITY (cross-brand)
// ─────────────────────────────────────────────

// One Consumer record spans all brands — like Stripe's Customer object.
// Stores quiz answers that are about the person (biology, lifestyle, location)
// so returning consumers get a shorter onboarding at each new brand.
model Consumer {
  id             String    @id @default(cuid())
  // The identifier partner brands see.
  //
  // A consumer's identity originates in Hallie, so when their Hallie account
  // is known this is hl_<hallieUserId> — one person, one id, the same in
  // both products. The random default only covers consumers who have no
  // Hallie account yet (synthetic demo data, or someone who reached a brand
  // before claiming their account); linkHallieAccount rewrites it the moment
  // the account appears.
  publicId       String    @unique @default(dbgenerated("('hl_' || substr(md5(random()::text), 1, 12))"))
  // The Hallie account this consumer is. Null until it can be resolved.
  hallieUserId   String?   @unique
  email          String?   @unique
  phone          String?   @unique
  birthday       DateTime?
  // JSON map of questionId → answer for brand-agnostic questions
  // e.g. { S1: "dry", S4: ["ACNE","DRYNESS"], SH1_location: {...}, H1: "coily" }
  prefillAnswers Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  endUsers        EndUser[]
  consumerEvents  ConsumerEvent[]
  consentGrants   ConsentGrant[]
  recommendations Recommendation[]
  connectEvents   ConnectEvent[]
  hallieShelf     HallieShelfProduct[]
  hallieLogs      HallieLog[]
  hallieSyncRuns  HallieSyncRun[]
  seasonalNudges  SeasonalNudge[]
  hallieRoutines  HallieRoutine[]
  hallieLayerings HallieLayering[]

  /// When the Hallie mirror last completed for this consumer. Null means
  /// never synced, which the job treats as due.
  lastHallieSyncAt DateTime?

  @@map("consumers")
}

// ─────────────────────────────────────────────
// END USERS (CONSUMERS)
// ─────────────────────────────────────────────

model EndUser {
  id         String  @id @default(cuid())
  brandId    String
  consumerId String?
  externalId String?
  email      String?
  firstName  String?
  lastName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand         Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  consumer      Consumer?          @relation(fields: [consumerId], references: [id])
  beautyProfile UserBeautyProfile?
  quizSessions  QuizSession[]
  routines      Routine[]
  checkIns      CheckIn[]

  @@unique([brandId, externalId])
  @@map("end_users")
}

// Replaces SkinProfile — covers all beauty areas
model UserBeautyProfile {
  id        String @id @default(cuid())
  endUserId String @unique

  // Focus areas this user has completed profiles for
  completedAreas BeautyArea[]

  // ── Location & Climate ─────────────────────
  city             String?
  country          String?
  countryCode      String?
  lat              Float?
  lng              Float?
  timezone         String?
  detectedCurrency String?      @default("USD")
  climateTag       ClimateType?
  climateSnapshot  Json? // raw 30d forecast data from WeatherAPI

  // ── Routine preference ─────────────────────
  routineFormat      RoutineFormat?
  selectedCategories ProductCategory[]

  // ── Spend ──────────────────────────────────
  spendMin      Float?
  spendMax      Float?
  spendCurrency String? @default("USD")

  // ── Shared lifestyle ───────────────────────
  waterIntakeMl String? // e.g. "1–1.5L", "Under 1L"
  sleepHours    String? // e.g. "5–7 hours", "Under 5 hours"
  stressLevel   Int? // 1–5

  // ── Skincare profile ───────────────────────
  ageRange     String? // under_18 | 18_24 | 25_34 | 35_44 | 45_54 | 55_64 | 65_plus
  monkSkinTone Int?
  skinType     SkinType?
  skinConcerns SkinConcern[]

  // ── Body profile (JSON — B1–B4 answers) ────
  bodyProfile Json?

  // ── Hair profile (JSON — H1–H6 answers) ────
  hairProfile Json?

  // ── Makeup profile (JSON — M1–M6 answers) ──
  makeupProfile Json?

  // ── Other area profiles ────────────────────
  fragranceProfile Json?
  nailsProfile     Json?
  wellnessProfile  Json?
  sunCareProfile   Json?
  lipProfile       Json?
  eyeProfile       Json?

  // ── AI Progress Narrative ──────────────────
  progressNarrative  String?
  narrativeUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  endUser EndUser @relation(fields: [endUserId], references: [id], onDelete: Cascade)

  @@map("user_beauty_profiles")
}

enum ClimateType {
  TROPICAL
  DRY_ARID
  TEMPERATE
  CONTINENTAL
  POLAR
  MEDITERRANEAN
}

enum HumidityLevel {
  LOW
  MODERATE
  HIGH
}

enum RoutineFormat {
  SINGLE
  ROUTINE
}

// ─────────────────────────────────────────────
// QUIZ
// ─────────────────────────────────────────────

model QuizSession {
  id            String       @id @default(cuid())
  brandId       String
  endUserId     String?
  selectedAreas BeautyArea[]
  answers       Json
  completed     Boolean      @default(false)
  completedAt   DateTime?
  createdAt     DateTime     @default(now())

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  endUser  EndUser?  @relation(fields: [endUserId], references: [id])
  routines Routine[]

  @@map("quiz_sessions")
}

// ─────────────────────────────────────────────
// ROUTINES
// ─────────────────────────────────────────────

model Routine {
  id             String     @id @default(cuid())
  endUserId      String
  quizSessionId  String
  focusArea      BeautyArea
  version        Int        @default(1)
  rationale      String?
  aiPromptTokens Int?
  reorderDue     DateTime?
  supersededBy   String?
  activeTo       DateTime?
  createdAt      DateTime   @default(now())

  endUser     EndUser       @relation(fields: [endUserId], references: [id], onDelete: Cascade)
  quizSession QuizSession   @relation(fields: [quizSessionId], references: [id])
  steps       RoutineStep[]

  @@map("routines")
}

model RoutineStep {
  id          String    @id @default(cuid())
  routineId   String
  productId   String
  timeOfDay   TimeOfDay
  step        Int
  instruction String?
  createdAt   DateTime  @default(now())

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([routineId, timeOfDay, step])
  @@map("routine_steps")
}

enum TimeOfDay {
  AM
  PM
  BOTH
  WASH_DAY
  BETWEEN_WASH
  DAILY
  WEEKLY
}

// ─────────────────────────────────────────────
// OUTCOME TRACKER
// ─────────────────────────────────────────────

model CheckIn {
  id                  String        @id @default(cuid())
  endUserId           String
  date                DateTime      @default(now())
  skinRating          Int
  photoUrl            String?
  symptoms            SkinSymptom[]
  notes               String?
  compliant           Boolean       @default(true)
  aiResult            String?
  aiResultGeneratedAt DateTime?
  createdAt           DateTime      @default(now())

  endUser  EndUser          @relation(fields: [endUserId], references: [id], onDelete: Cascade)
  products CheckInProduct[]

  @@map("check_ins")
}

enum SkinSymptom {
  BREAKOUT
  DRYNESS
  REDNESS
  IRRITATION
  PURGING
  OILINESS
  DULLNESS
  IMPROVEMENT
  GLOW
  HYDRATED
  TEXTURE_SMOOTH
  HYPERPIGMENTATION_FADING
}

model CheckInProduct {
  id        String           @id @default(cuid())
  checkInId String
  productId String
  used      Boolean          @default(true)
  reaction  ProductReaction?

  checkIn CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("check_in_products")
}

enum ProductReaction {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

// ─────────────────────────────────────────────
// CRYSTAL — AI CONVERSATIONS
// ─────────────────────────────────────────────

// Scope: brandId set → brand Crystal; brandId null → Halite admin Crystal
model CrystalConversation {
  id        String           @id @default(cuid())
  brandId   String?
  adminId   String // BrandAdmin.id or HaliteAdmin.id
  adminRole CrystalAdminRole
  title     String           @default("New conversation")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  messages CrystalMessage[]

  @@index([brandId])
  @@index([adminId])
  @@map("crystal_conversations")
}

model CrystalMessage {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  tokenCount     Int?
  createdAt      DateTime    @default(now())

  conversation CrystalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("crystal_messages")
}

enum CrystalAdminRole {
  BRAND
  HALITE
}

enum MessageRole {
  USER
  ASSISTANT
}

// ─────────────────────────────────────────────
// BILLING
// ─────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Invoice {
  id        String        @id @default(cuid())
  brandId   String
  brand     Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  amount    Float
  currency  String        @default("USD")
  status    InvoiceStatus @default(DRAFT)
  period    String
  dueDate   DateTime
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("invoices")
}

// ─────────────────────────────────────────────
// AURA CONSUMER EVENTS
// ─────────────────────────────────────────────

enum ConsumerEventType {
  OUTCOME_LOGGED
  TRANSACTION_COMPLETED
  PREFERENCE_UPDATED
  PRODUCT_TRACKED
}

enum ConsumerEventSource {
  AURA
  SHOPIFY
  ECOMM_INTEGRATION
}

model ConsumerEvent {
  id         String              @id @default(cuid())
  brandId    String
  consumerId String?
  auraUserId String
  type       ConsumerEventType
  source     ConsumerEventSource @default(AURA)
  data       Json
  occurredAt DateTime
  createdAt  DateTime            @default(now())

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  consumer Consumer? @relation(fields: [consumerId], references: [id])

  @@index([brandId, type, occurredAt(sort: Desc)])
  @@index([consumerId, occurredAt(sort: Desc)])
  @@map("consumer_events")
}

// ─────────────────────────────────────────────
// AGENT WORKFLOWS
// ─────────────────────────────────────────────

model AgentWorkflow {
  id          String            @id @default(cuid())
  brandId     String
  name        String
  description String?
  type        AgentWorkflowType
  config      Json
  isActive    Boolean           @default(true)
  isPrebuilt  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  brand Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  runs  AgentRun[]

  @@index([brandId])
  @@map("agent_workflows")
}

enum AgentWorkflowType {
  ROUTINE_OUTCOME
  CHURN_PREDICTION
  PRODUCT_INTELLIGENCE
  CONVERSION
  EXECUTIVE_INTELLIGENCE
  CUSTOM
}

model AgentRun {
  id         String         @id @default(cuid())
  workflowId String
  status     AgentRunStatus @default(PENDING)
  input      Json?
  output     Json?
  tokenCount Int?
  createdAt  DateTime       @default(now())

  workflow AgentWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("agent_runs")
}

enum AgentRunStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// ─────────────────────────────────────────────
// HALITE CONNECT
// Permissioned, portable consumer context for partner brands.
// A grant is the unit of permission: one brand, one consumer, the
// categories that brand sells. Pilot grants have no expiry — access
// runs until the consumer revokes it (expiresAt stays null).
// ─────────────────────────────────────────────

enum ConsentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

/// What a grant lets a brand read, one switch per group.
///
/// Category scope answers "which beauty areas"; this answers "how much of
/// them". The Permission Center in Hallie renders one row per value, so a
/// shopper can hand a brand their notes without handing over their shelf.
enum ConsentSignal {
  /// Stated preferences and quiz answers inside the granted categories.
  PREFERENCES
  /// Products of this brand's own that the shopper owns, named in full.
  COLLECTION
  /// Ratings and outcomes on this brand's own products.
  PRODUCT_FEEDBACK
  /// De-identified outcome aggregates from everything else they own.
  CROSS_BRAND
  /// Reactions, sensitivities and the cautions that follow from them.
  SENSITIVITIES
  /// Budget band, occasions, how much they get through.
  INTENT
  /// Where they bought it. Off unless the shopper turns it on.
  RETAILERS
}

/// Where a shelf product's notes or ingredients came from.
enum AttributeSource {
  /// Matched to a product in a Halite brand catalog. Trustworthy.
  CATALOG
  /// Looked up from the brand and name at sync time. A brand should weigh
  /// these lower — the lookup can be wrong, and a wrong attribute that
  /// recurs twice becomes a signal.
  INFERRED
  /// Nothing resolved. Contributes a product type and nothing else.
  NONE
}

model ConsentGrant {
  id         String          @id @default(cuid())
  brandId    String
  consumerId String
  // Snapshot of the brand's focus areas at grant time. The brand cannot
  // widen its own scope later without asking the consumer again.
  categories BeautyArea[]
  /// The signal groups this grant covers. Everything except RETAILERS is on
  /// by default; that one is opt-in only, and only the shopper can add it.
  signals    ConsentSignal[] @default([PREFERENCES, COLLECTION, PRODUCT_FEEDBACK, CROSS_BRAND, SENSITIVITIES, INTENT])
  purpose    String          @default("product_recommendations")
  status     ConsentStatus   @default(ACTIVE)
  // Where the consumer was when they connected — pdp, quiz, collection…
  surface    String?
  grantedAt  DateTime        @default(now())
  revokedAt  DateTime?
  // Unused in the pilot. Reserved so time-limited grants do not need a
  // second migration; a null expiry means "until revoked".
  expiresAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  brand           Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  consumer        Consumer           @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]
  accessLogs      ConsentAccessLog[]

  @@unique([brandId, consumerId])
  @@index([brandId, status])
  @@index([consumerId, status])
  @@map("consent_grants")
}

// One row per time a brand's key actually read a consumer's context.
// This is what the consumer's access log and the brand's audit view read.
model ConsentAccessLog {
  id         String   @id @default(cuid())
  grantId    String
  brandId    String
  consumerId String
  // "context" | "recommendations" | "refused"
  action     String
  // Number of catalog products scored, when the action ranked anything.
  scoped     Int?
  detail     Json?
  createdAt  DateTime @default(now())

  grant ConsentGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([consumerId, createdAt(sort: Desc)])
  @@index([brandId, createdAt(sort: Desc)])
  @@map("consent_access_logs")
}

model Recommendation {
  id         String   @id @default(cuid())
  brandId    String
  consumerId String
  grantId    String
  // The permissioned context snapshot the ranking was built from, so a
  // recommendation stays explainable after the profile moves on.
  context    Json
  // [{ productId, sku, name, score, reasons: [] }]
  items      Json
  surface    String?
  createdAt  DateTime @default(now())

  brand    Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  consumer Consumer       @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  grant    ConsentGrant   @relation(fields: [grantId], references: [id], onDelete: Cascade)
  events   ConnectEvent[]

  @@index([brandId, createdAt(sort: Desc)])
  @@index([consumerId, createdAt(sort: Desc)])
  @@map("recommendations")
}

enum ConnectEventType {
  PROMPT_SHOWN
  CONNECT_ACCEPTED
  CONNECT_DECLINED
  RECOMMENDATION_SHOWN
  PRODUCT_VIEWED
  ADD_TO_CART
  // The shopper saved the product from the brand's storefront. Halite
  // mirrors this into their Hallie wishlist collection.
  WISHLISTED
  PURCHASE
  RETURNED
  RATED
}

// Everything the storefront reports back. PROMPT_SHOWN and the two
// CONNECT_* types carry no consumerId until the consumer connects —
// that pair is what makes an acceptance rate computable per surface.
model ConnectEvent {
  id               String           @id @default(cuid())
  brandId          String
  consumerId       String?
  recommendationId String?
  productId        String?
  sku              String?
  type             ConnectEventType
  surface          String?
  value            Float?
  currency         String?          @default("USD")
  // Anonymous storefront visitor id, so a prompt shown can be tied to
  // the acceptance that follows it without knowing who the person is.
  visitorId        String?
  metadata         Json?
  occurredAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())

  brand          Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  consumer       Consumer?       @relation(fields: [consumerId], references: [id])
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id])

  @@index([brandId, type, occurredAt(sort: Desc)])
  @@index([brandId, surface, type])
  @@index([consumerId, occurredAt(sort: Desc)])
  @@index([recommendationId])
  @@map("connect_events")
}

// ─────────────────────────────────────────────────────────────────────────
// Hallie mirror
//
// Hallie owns the shopper's shelf and their daily logs. Connect reads the
// context live, so it is never stale — but the brand dashboard aggregates,
// and aggregating across a foreign schema on every page load is neither
// fast nor safe. So a job mirrors the parts a brand can see into these
// tables every few days, and the dashboard reads only from here.
//
// Nothing in this mirror is brand-identifying on its own. A shelf product
// keeps its resolution and its attributes; the brand and product name the
// shopper typed stay in Hallie.
// ─────────────────────────────────────────────────────────────────────────

/// One product on a shopper's Hallie shelf, resolved once rather than per log.
model HallieShelfProduct {
  id              String           @id @default(cuid())
  consumerId      String
  /// The row this mirrors, in Hallie's own schema.
  hallieProductId String
  beautyArea      BeautyArea?
  category        ProductCategory?
  /// Hallie's own free-text type ("eau de parfum", "body lotion"). Kept
  /// because it survives when nothing else resolves.
  productType     String?
  /// The Halite catalog product this matched, when it matched one. This is
  /// also how "did the requesting brand sell it" is answered.
  productId       String?
  /// Notes for fragrance, ingredients everywhere else. Capped on read.
  attributes      String[]
  /// Hallie rates a product once, on the shelf, rather than per log — so
  /// this is where a rating actually lives. Two scales: `rating` is out of
  /// ten, `feedbackRating` out of five, and both are carried rather than
  /// flattened so neither has to be guessed at downstream.
  rating          Float?
  feedbackRating  Int?
  wouldRepurchase Boolean?
  outcomeTags     String[]
  /// What is left in the bottle. `initialLevel` is where it started,
  /// `statedLevel` is the last time the shopper corrected it by hand, and
  /// the estimate is computed on read from those two plus how often it
  /// gets logged — never stored, so it cannot go stale.
  initialLevel    Int?
  statedLevel     Int?
  statedLevelAt   DateTime?
  isEmpty         Boolean          @default(false)
  emptiedAt       DateTime?
  repurchasedAt   DateTime?
  sizeValue       Float?
  sizeUnit        String?
  attributeSource AttributeSource  @default(NONE)
  enrichedAt      DateTime?
  firstSeenAt     DateTime         @default(now())
  lastSeenAt      DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  consumer     Consumer            @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  product      Product?            @relation(fields: [productId], references: [id])
  logItems     HallieLogItem[]
  routineItems HallieRoutineItem[]

  @@unique([consumerId, hallieProductId])
  @@index([consumerId])
  @@index([productId])
  @@map("hallie_shelf_products")
}

/// One logging session in Hallie — a day, in one category.
model HallieLog {
  id            String      @id @default(cuid())
  consumerId    String
  hallieEntryId String
  /// Hallie's own category string: skincare, body, hair, makeup, perfume.
  category      String
  beautyArea    BeautyArea?
  loggedAt      DateTime
  createdAt     DateTime    @default(now())

  consumer Consumer        @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  items    HallieLogItem[]

  @@unique([consumerId, hallieEntryId])
  @@index([consumerId, loggedAt(sort: Desc)])
  @@map("hallie_logs")
}

/// What the shopper said about one product on one day.
model HallieLogItem {
  id              String   @id @default(cuid())
  logId           String
  hallieItemId    String
  shelfProductId  String?
  /// Hallie's own scale, carried through rather than flattened to a
  /// three-state reaction — a 3/5 and a 1/5 are not the same thing.
  rating          Int?
  wouldRepurchase Boolean?
  outcomeTags     String[]
  /// Makeup only: how long it lasted, how it looked by the end of the day.
  wearDuration    String?
  endOfDayLook    String?
  createdAt       DateTime @default(now())

  log          HallieLog           @relation(fields: [logId], references: [id], onDelete: Cascade)
  shelfProduct HallieShelfProduct? @relation(fields: [shelfProductId], references: [id], onDelete: SetNull)

  @@unique([logId, hallieItemId])
  @@index([shelfProductId])
  @@map("hallie_log_items")
}

/// One pass of the mirror job, for observability and for backing off.
model HallieSyncRun {
  id               String    @id @default(cuid())
  consumerId       String
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  ok               Boolean   @default(false)
  logsPulled       Int       @default(0)
  itemsPulled      Int       @default(0)
  productsResolved Int       @default(0)
  productsEnriched Int       @default(0)
  error            String?

  consumer Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  @@index([consumerId, startedAt(sort: Desc)])
  @@map("hallie_sync_runs")
}

/// One seasonal nudge sent to one shopper.
///
/// Its own table rather than a ConsumerEvent because a nudge is not a
/// brand's event — it originates with Halite, it belongs to no brand, and
/// ConsumerEvent requires one. The cooldown query reads this back.
model SeasonalNudge {
  id         String   @id @default(cuid())
  consumerId String
  direction  String
  season     String?
  /// What they were moving toward when it fired, for reading back later.
  favour     String[]
  confidence Float
  sentAt     DateTime @default(now())

  consumer Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  @@index([consumerId, sentAt(sort: Desc)])
  @@map("seasonal_nudges")
}

/// A routine the shopper assembled in Hallie — their own stack, not one we
/// suggested. Recommendations shown to them are deliberately not mirrored;
/// a brand should see what someone actually wears.
model HallieRoutine {
  id            String   @id @default(cuid())
  consumerId    String
  hallieStackId String
  name          String?
  timeOfDay     String?
  isEveryday    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  consumer Consumer            @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  items    HallieRoutineItem[]

  @@unique([consumerId, hallieStackId])
  @@index([consumerId])
  @@map("hallie_routines")
}

model HallieRoutineItem {
  id             String  @id @default(cuid())
  routineId      String
  shelfProductId String?
  /// Order in the routine. This is the layering information — step 2 of 3
  /// means something different from step 1.
  position       Int

  routine      HallieRoutine       @relation(fields: [routineId], references: [id], onDelete: Cascade)
  shelfProduct HallieShelfProduct? @relation(fields: [shelfProductId], references: [id], onDelete: SetNull)

  @@unique([routineId, position])
  @@index([shelfProductId])
  @@map("hallie_routine_items")
}

/// One dated combination the shopper actually put on, with their own reason.
///
/// Distinct from a routine: a routine is the intent, this is the day. The
/// gap between them is usually where the interesting behaviour is.
model HallieLayering {
  id              String   @id @default(cuid())
  consumerId      String
  hallieChoiceId  String
  dayKey          String
  slot            String?
  /// Mirror ids, in the order they were layered.
  shelfProductIds String[]
  why             String?
  moods           String[]
  occasions       String[]
  createdAt       DateTime @default(now())

  consumer Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  @@unique([consumerId, hallieChoiceId])
  @@index([consumerId, dayKey])
  @@map("hallie_layerings")
}
