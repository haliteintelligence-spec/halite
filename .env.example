# ── Database (Railway PostgreSQL) ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/halite?sslmode=require"

# ── API ────────────────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET="change-me-to-a-long-random-secret"
API_BASE_URL="https://api.haliteintelligence.com"
LOG_LEVEL="info"

# ── Anthropic (Claude) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── OpenAI (product embeddings — text-embedding-3-small, 1536 dims) ───────
OPENAI_API_KEY="sk-..."

# ── Location & Climate ────────────────────────────────────────────────────
GEOCODING_API_KEY=""      # OpenCage — https://opencagedata.com (2,500 req/day free)
WEATHER_API_KEY=""        # WeatherAPI.com — https://weatherapi.com (free: 14d forecast)

# ── AWS S3 (catalog uploads, check-in photos) ────────────────────────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET="halite-intelligence"

# ── Shopify ───────────────────────────────────────────────────────────────
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_WEBHOOK_SECRET=""
DASHBOARD_URL="https://haliteadmin-production.up.railway.app"

# ── Dashboard (Next.js) ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="https://api.haliteintelligence.com"
NEXT_PUBLIC_ROOT_DOMAIN="haliteintelligence.com"
